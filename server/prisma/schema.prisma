// Velozity assessment — data model.
// Design notes (indexing rationale) live in the README; the short version is
// that every index below exists to serve one named query, not speculatively.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Deliberately no `directUrl`. A pooled PgBouncer endpoint (Neon's
  // `-pooler` host) does not preserve the advisory locks and prepared
  // statements `prisma migrate deploy` relies on, and `start` runs it on every
  // boot. Carrying one direct URL — the one Neon gives you by default, without
  // `-pooler` — removes a second credential that could be pasted wrong. See
  // README §6 for the connection-ceiling this accepts.
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActivityType {
  TASK_CREATED
  STATUS_CHANGED
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_UPDATED
  OVERDUE_FLAGGED
  PROJECT_CREATED
  PROJECT_UPDATED
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members User[]

  @@map("teams")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  teamId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  team            Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdProjects Project[]        @relation("ProjectCreator")
  assignedTasks   Task[]           @relation("TaskAssignee")
  activities      ActivityLog[]    @relation("ActivityActor")
  notifications   Notification[]
  refreshTokens   RefreshToken[]

  @@index([role])
  @@index([teamId])
  @@map("users")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  projects Project[]

  @@map("clients")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  clientId    String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client    Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy User          @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks     Task[]
  activity  ActivityLog[]

  // PM dashboard and "my projects" listing: filter by owner, newest first.
  @@index([createdById, createdAt])
  @@index([clientId])
  @@map("projects")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  projectId   String
  assigneeId  String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  // Stored, not derived: the brief requires the scheduled job to set this.
  isOverdue   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  activity ActivityLog[]

  // Status counts within a project (PM + admin dashboards).
  @@index([projectId, status])
  // Developer dashboard: "my tasks", optionally narrowed by status.
  @@index([assigneeId, status])
  // Developer dashboard ordering: priority then due date.
  @@index([assigneeId, priority, dueDate])
  // Overdue cron sweep and overdue counter.
  @@index([dueDate])
  @@index([isOverdue])
  @@map("tasks")
}

model ActivityLog {
  id        String       @id @default(cuid())
  type      ActivityType
  message   String
  // Present for task-scoped events; null for project-level events.
  taskId    String?
  projectId String
  actorId   String
  fromValue String?
  toValue   String?
  createdAt DateTime     @default(now())

  task  Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor User     @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Restrict)

  // Per-project feed, newest first. Composite because every read filters by project
  // and orders by time; the leading equality column makes the sort index-ordered.
  @@index([projectId, createdAt(sort: Desc)])
  // Developer-scoped feed ("activity on tasks assigned to me").
  @@index([actorId, createdAt(sort: Desc)])
  // Admin global feed.
  @@index([createdAt(sort: Desc)])
  // Catch-up query and per-task history.
  @@index([taskId, createdAt(sort: Desc)])
  @@map("activity_logs")
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  message    String
  link       String?
  activityId String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unread badge count — hit on essentially every page load.
  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  // SHA-256 of the token. The raw value is never stored, so a DB leak
  // does not hand over usable sessions.
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  // Set when this token is rotated, so replay of a rotated token can be
  // detected and the whole family revoked.
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
