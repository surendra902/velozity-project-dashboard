# ---- Copy to .env and fill in. Never commit real secrets. ----

# Postgres connection string. Neon free tier is what this project is deployed against.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT signing secrets. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Access and refresh MUST use different secrets so a leaked access secret
# cannot be used to mint refresh tokens.
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me"

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"

NODE_ENV="development"
PORT="4000"

# Comma-separated. Credentials must be included so the browser sends the
# HttpOnly refresh cookie cross-origin.
CORS_ORIGIN="http://localhost:5173"

# Set true in production so the refresh cookie is marked Secure.
COOKIE_SECURE="false"
